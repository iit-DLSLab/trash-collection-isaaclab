<mujoco model="aliengo scene">
      <include file="aliengo_z1.xml"/>

      <statistic center="0 0 0.1" extent="0.8"/>

      <visual>
            <headlight diffuse="0.4 0.4 0.4" ambient="0.25 0.25 0.25" specular="0.25 0.25 0.25"/>
            <rgba haze="0.99 0.99 0.99 1"/>
            <global azimuth="-130" elevation="-20"/>
      </visual>
      <asset>
            <texture
                  type="skybox"
                  builtin="gradient"
                  rgb1="0.99 0.99 0.99"
                  rgb2="0.99 0.99 0.99"
                  width="512"
                  height="3072"
            />
            <texture
                  type="2d"
                  name="groundplane"
                  builtin="checker"
                  mark="edge"
                  rgb1="0.93 0.93 0.93"
                  rgb2="0.93 0.93 0.93"
                  markrgb="0 0 0"
                  width="250"
                  height="250"
            />
            <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.0"/>
            
            <mesh name="waterbottle" file="waterbottle/waterbottle.stl"/>
      </asset>


      <worldbody>
            <light pos="0 0 5.0" dir="0 0 -1" directional="true" castshadow="false"/>

            <body name="waterbottle" pos="0.5 0.0 0.05" quat="0.70710678 0.70710678 0 0">
                  <geom name="waterbottle_visual" type="mesh" mesh="waterbottle" rgba=".6 .3 .3 .5"/>
                  <site name="waterbottle_site" size="0.01" quat="-0.5 0.5 -0.5 0.5" rgba="1 0 0 1" group="1"/>
            </body>

            <geom name="floor" size="0 0 0.05" type="plane" material="groundplane"/>
      </worldbody>
</mujoco>
